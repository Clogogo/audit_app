# Python files (API runs on Render, not Vercel)
# Note: these are anchored to the repo root (leading "/") on purpose — an
# unanchored "api/" also matches apps/web/src/api/, which is the frontend's
# own API client code and must NOT be excluded.
/api/
/apps/api/
*.py

# Ignore local development files
.env
.env.local
.venv
node_modules
dist
.git
.gitignore
.DS_Store

# Ignore documentation
*.md

# Ignore test files
__pycache__
*.pyc


