# Database Configuration
# =====================
# Using SQLite for Vercel compatibility
# No external endpoint dependencies required

# Optional: Custom database path
# DB_PATH=/path/to/db/directory
# Default: Project root directory
# For Vercel: Leave empty or set to /tmp

# Enable SQL query logging (for debugging)
SQL_ECHO=False

# Authentication
# ==============
# Required — the app refuses to start without this set (no insecure default).
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# One-time admin bootstrap: the account with this email becomes admin, but
# only while zero admins exist anywhere in the database — it's a no-op
# forever after the first admin is established (this one, or any later
# promotion via the User Management page). Leave unset to bootstrap no
# admin at all (safe default for local dev/CI — nobody gets auto-admin'd).
BOOTSTRAP_ADMIN_EMAIL=

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Frontend Configuration
# ======================
# Leave blank for local development (CORS allows localhost)
# Set to your Vercel/Render frontend URL in production
# Also used to build the link inside password-reset emails.
FRONTEND_URL=

# File Upload
# ===========
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=uploads

# CORS Configuration
# ==================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (Maileroo) — required for POST /auth/forgot-password to actually send
# a reset link. Sign up at https://maileroo.com (free tier: 3,000/month, no
# domain verification needed — it assigns you a free sending subdomain like
# <random>.maileroo.org, shown on your dashboard's Sending Domains page).
# Unlike some providers, Maileroo's free tier can send to any recipient, not
# just your own signup email.
# =============================
MAILEROO_API_KEY=your_maileroo_sending_key_here
MAILEROO_FROM_EMAIL=noreply@your-assigned-subdomain.maileroo.org
