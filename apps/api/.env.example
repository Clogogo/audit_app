# Database Configuration
# =====================
# Using SQLite for Vercel compatibility
# No external endpoint dependencies required

# Optional: Custom database path
# DB_PATH=/path/to/db/directory
# Default: Project root directory
# For Vercel: Leave empty or set to /tmp

# Enable SQL query logging (for debugging)
SQL_ECHO=False

# Authentication
# ==============
# Required — the app refuses to start without this set (no insecure default).
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Required for POST /auth/register — anyone without this exact code is
# rejected with 403. Generate a random value, share it only with people you
# actually want to be able to create an account.
REGISTRATION_INVITE_CODE=change-me-to-a-random-value

# Required for POST /auth/forgot-password — without this set (or if the
# request's recovery_code doesn't match), password reset by email is
# disabled entirely. Generate a random value; only the admin should know it.
PASSWORD_RECOVERY_CODE=change-me-to-a-random-value

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Frontend Configuration
# ======================
# Leave blank for local development (CORS allows localhost)
# Set to your Vercel/Render frontend URL in production
FRONTEND_URL=

# File Upload
# ===========
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=uploads

# CORS Configuration
# ==================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email Configuration (Optional)
# =============================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
