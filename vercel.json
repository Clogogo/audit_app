{
  "buildCommand": "npx nx build web",
  "outputDirectory": "dist/apps/web",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NX_DAEMON": "false"
  },
  "ignoreCommand": "npx dlx nx-ignore web",
  "api": {
    "runtime": "python@3.11",
    "builder": "@vercel/python"
  },
  "functions": {
    "apps/api/**": {
      "runtime": "python@3.11"
    }
  }
}