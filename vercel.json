{
  "buildCommand": "npx nx build web",
  "outputDirectory": "dist/apps/web",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NX_DAEMON": "false"
  },
  "ignoreCommand": "npx dlx nx-ignore web"
}